# Copy this file to `.env` and fill in your values. NEVER commit `.env`.
# Get free testnet keys at https://testnet.binancefuture.com (Futures testnet).

# --- required: Binance Futures TESTNET API keys ---
BINANCE_TESTNET_API_KEY=your_testnet_key_here
BINANCE_TESTNET_SECRET_KEY=your_testnet_secret_here

# --- safety: keep this true. Only set false for real-money trading. ---
TESTNET=true

# --- what to trade ---
# Start with BTCUSDT ONLY: it is the only symbol backtested. The others run
# the same code but are unvalidated -- add them only after backtesting them
# (fetch_data.py + backtest_portfolio.py).
SYMBOLS=BTCUSDT
MAX_CONCURRENT_POSITIONS=2

# --- sizing (defaults are the survivable settings from research/) ---
# 1% risk, 10x. Raising risk raises return AND drawdown one-for-one;
# more leverage only deepens drawdown. 2% is the aggressive-but-sane ceiling.
RISK_PER_TRADE_PCT=0.01
LEVERAGE=10

# --- optional: Telegram alerts on fills / circuit breaker ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
