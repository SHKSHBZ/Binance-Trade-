# indie:lang_version = 5
# ============================================================================
#  GOLD MERGE SIGNAL  -  companion to "Gold Merge", for ALERTS
#
#  Same trade logic as gold_merge.indie (generated from the same template),
#  shown as ONE value in its own pane under the chart:
#     +1  while a BUY  trade is open  (green)
#     -1  while a SELL trade is open  (red)
#      0  no trade                    (gray)
#
#  ALERTS (Exness Terminal alert window, source = Gold Merge Signal):
#     BUY  appeared  ->  Signal  crossing up    0.5
#     SELL appeared  ->  Signal  crossing down -0.5
#     trade finished ->  Signal  crossing 0   (optional)
#  Choose "once per bar close" if offered, so it only fires on a CLOSED candle.
#
#  XAUUSD 1-hour chart only. Do not change the tested numbers.
# ============================================================================
from math import nan
from indie import indicator, plot, color, MutSeriesF


@indicator('Gold Merge Signal', overlay_main_pane=False)
@plot.line(title='Signal (+1 BUY / -1 SELL / 0 none)')
def Main(self):
    # ------------------------------------------------------------------
    # 1. TREND from BIG swings (16 candles each side ~ one 4-hour swing)
    #    GREEN once a close breaks the last big swing high
    #    RED   once a close breaks the last big swing low
    # ------------------------------------------------------------------
    big_swing_high = (self.high[16] >= self.high[0] and self.high[16] >= self.high[1] and self.high[16] >= self.high[2] and
                      self.high[16] >= self.high[3] and self.high[16] >= self.high[4] and self.high[16] >= self.high[5] and
                      self.high[16] >= self.high[6] and self.high[16] >= self.high[7] and self.high[16] >= self.high[8] and
                      self.high[16] >= self.high[9] and self.high[16] >= self.high[10] and self.high[16] >= self.high[11] and
                      self.high[16] >= self.high[12] and self.high[16] >= self.high[13] and self.high[16] >= self.high[14] and
                      self.high[16] >= self.high[15] and self.high[16] >= self.high[17] and self.high[16] >= self.high[18] and
                      self.high[16] >= self.high[19] and self.high[16] >= self.high[20] and self.high[16] >= self.high[21] and
                      self.high[16] >= self.high[22] and self.high[16] >= self.high[23] and self.high[16] >= self.high[24] and
                      self.high[16] >= self.high[25] and self.high[16] >= self.high[26] and self.high[16] >= self.high[27] and
                      self.high[16] >= self.high[28] and self.high[16] >= self.high[29] and self.high[16] >= self.high[30] and
                      self.high[16] >= self.high[31] and self.high[16] >= self.high[32])
    big_swing_low = (self.low[16] <= self.low[0] and self.low[16] <= self.low[1] and self.low[16] <= self.low[2] and
                      self.low[16] <= self.low[3] and self.low[16] <= self.low[4] and self.low[16] <= self.low[5] and
                      self.low[16] <= self.low[6] and self.low[16] <= self.low[7] and self.low[16] <= self.low[8] and
                      self.low[16] <= self.low[9] and self.low[16] <= self.low[10] and self.low[16] <= self.low[11] and
                      self.low[16] <= self.low[12] and self.low[16] <= self.low[13] and self.low[16] <= self.low[14] and
                      self.low[16] <= self.low[15] and self.low[16] <= self.low[17] and self.low[16] <= self.low[18] and
                      self.low[16] <= self.low[19] and self.low[16] <= self.low[20] and self.low[16] <= self.low[21] and
                      self.low[16] <= self.low[22] and self.low[16] <= self.low[23] and self.low[16] <= self.low[24] and
                      self.low[16] <= self.low[25] and self.low[16] <= self.low[26] and self.low[16] <= self.low[27] and
                      self.low[16] <= self.low[28] and self.low[16] <= self.low[29] and self.low[16] <= self.low[30] and
                      self.low[16] <= self.low[31] and self.low[16] <= self.low[32])

    big_hi = MutSeriesF.new(nan)
    big_lo = MutSeriesF.new(nan)
    trend = MutSeriesF.new(0.0)
    big_hi[0] = big_hi[1]
    big_lo[0] = big_lo[1]
    trend[0] = trend[1]
    if trend[0] != trend[0]:
        trend[0] = 0.0
    if big_swing_high:
        big_hi[0] = self.high[16]
    if big_swing_low:
        big_lo[0] = self.low[16]
    if big_hi[0] == big_hi[0] and self.close[0] > big_hi[0]:
        trend[0] = 1.0
        big_hi[0] = nan
    if big_lo[0] == big_lo[0] and self.close[0] < big_lo[0]:
        trend[0] = -1.0
        big_lo[0] = nan

    # ------------------------------------------------------------------
    # 2. SMALL swings (3 candles each side) -> line in the sand
    #    uptrend:   the swing low that came before the latest swing high
    #    downtrend: the swing high that came before the latest swing low
    # ------------------------------------------------------------------
    small_swing_high = (self.high[3] >= self.high[0] and self.high[3] >= self.high[1] and self.high[3] >= self.high[2] and
                        self.high[3] >= self.high[4] and self.high[3] >= self.high[5] and self.high[3] >= self.high[6])
    small_swing_low = (self.low[3] <= self.low[0] and self.low[3] <= self.low[1] and self.low[3] <= self.low[2] and
                        self.low[3] <= self.low[4] and self.low[3] <= self.low[5] and self.low[3] <= self.low[6])

    sm_hi = MutSeriesF.new(nan)
    sm_lo = MutSeriesF.new(nan)
    sand_lo = MutSeriesF.new(nan)
    sand_hi = MutSeriesF.new(nan)
    sm_hi[0] = sm_hi[1]
    sm_lo[0] = sm_lo[1]
    sand_lo[0] = sand_lo[1]
    sand_hi[0] = sand_hi[1]

    # ------------------------------------------------------------------
    # 3. MAJOR levels = highest swing low / lowest swing high of roughly
    #    the last 1500-2000 candles, kept in 4 buckets of 500 candles.
    # ------------------------------------------------------------------
    lo_b0 = MutSeriesF.new(nan)
    lo_b1 = MutSeriesF.new(nan)
    lo_b2 = MutSeriesF.new(nan)
    lo_b3 = MutSeriesF.new(nan)
    hi_b0 = MutSeriesF.new(nan)
    hi_b1 = MutSeriesF.new(nan)
    hi_b2 = MutSeriesF.new(nan)
    hi_b3 = MutSeriesF.new(nan)
    count = MutSeriesF.new(0.0)
    lo_b0[0] = lo_b0[1]
    lo_b1[0] = lo_b1[1]
    lo_b2[0] = lo_b2[1]
    lo_b3[0] = lo_b3[1]
    hi_b0[0] = hi_b0[1]
    hi_b1[0] = hi_b1[1]
    hi_b2[0] = hi_b2[1]
    hi_b3[0] = hi_b3[1]
    if count[1] != count[1]:
        count[0] = 1.0
    else:
        count[0] = count[1] + 1.0
    if count[0] >= 500.0:
        count[0] = 0.0
        lo_b3[0] = lo_b2[0]
        lo_b2[0] = lo_b1[0]
        lo_b1[0] = lo_b0[0]
        lo_b0[0] = nan
        hi_b3[0] = hi_b2[0]
        hi_b2[0] = hi_b1[0]
        hi_b1[0] = hi_b0[0]
        hi_b0[0] = nan

    if small_swing_high:
        sand_lo[0] = sm_lo[0]
        sm_hi[0] = self.high[3]
        if hi_b0[0] != hi_b0[0] or self.high[3] < hi_b0[0]:
            hi_b0[0] = self.high[3]
    if small_swing_low:
        sand_hi[0] = sm_hi[0]
        sm_lo[0] = self.low[3]
        if lo_b0[0] != lo_b0[0] or self.low[3] > lo_b0[0]:
            lo_b0[0] = self.low[3]

    major_lo = lo_b0[0]
    if lo_b1[0] == lo_b1[0] and (major_lo != major_lo or lo_b1[0] > major_lo):
        major_lo = lo_b1[0]
    if lo_b2[0] == lo_b2[0] and (major_lo != major_lo or lo_b2[0] > major_lo):
        major_lo = lo_b2[0]
    if lo_b3[0] == lo_b3[0] and (major_lo != major_lo or lo_b3[0] > major_lo):
        major_lo = lo_b3[0]
    major_hi = hi_b0[0]
    if hi_b1[0] == hi_b1[0] and (major_hi != major_hi or hi_b1[0] < major_hi):
        major_hi = hi_b1[0]
    if hi_b2[0] == hi_b2[0] and (major_hi != major_hi or hi_b2[0] < major_hi):
        major_hi = hi_b2[0]
    if hi_b3[0] == hi_b3[0] and (major_hi != major_hi or hi_b3[0] < major_hi):
        major_hi = hi_b3[0]

    # the major level only counts while it sits inside the line in the sand
    watch_lo = nan
    if major_lo == major_lo and sand_lo[0] == sand_lo[0] and major_lo > sand_lo[0]:
        watch_lo = major_lo
    watch_hi = nan
    if major_hi == major_hi and sand_hi[0] == sand_hi[0] and major_hi < sand_hi[0]:
        watch_hi = major_hi

    # ------------------------------------------------------------------
    # 4. OPEN TRADE: was the stop or the target hit on this candle?
    # ------------------------------------------------------------------
    t_dir = MutSeriesF.new(0.0)
    t_entry = MutSeriesF.new(nan)
    t_stop = MutSeriesF.new(nan)
    t_target = MutSeriesF.new(nan)
    t_age = MutSeriesF.new(0.0)
    t_dir[0] = t_dir[1]
    t_entry[0] = t_entry[1]
    t_stop[0] = t_stop[1]
    t_target[0] = t_target[1]
    t_age[0] = t_age[1]
    if t_dir[0] != t_dir[0]:
        t_dir[0] = 0.0
    if t_age[0] != t_age[0]:
        t_age[0] = 0.0

    closed_now = False
    if t_dir[0] != 0.0:
        t_age[0] = t_age[0] + 1.0
        done = False
        if t_dir[0] > 0.0 and (self.low[0] <= t_stop[0] or self.high[0] >= t_target[0]):
            done = True
        if t_dir[0] < 0.0 and (self.high[0] >= t_stop[0] or self.low[0] <= t_target[0]):
            done = True
        if t_age[0] >= 100.0:
            done = True
        if done:
            t_dir[0] = 0.0
            t_entry[0] = nan
            t_stop[0] = nan
            t_target[0] = nan
            closed_now = True

    # ------------------------------------------------------------------
    # 5. NEW SIGNAL (only when no trade is open)
    # ------------------------------------------------------------------
    if t_dir[0] == 0.0 and not closed_now:
        min_risk = 0.0005 * self.close[0]
        if min_risk < 1.0:
            min_risk = 1.0

        go_long = (trend[0] > 0.5 and watch_lo == watch_lo and
                   self.low[0] < watch_lo and self.close[0] > watch_lo and
                   self.low[0] > sand_lo[0])
        go_short = (trend[0] < -0.5 and watch_hi == watch_hi and
                    self.high[0] > watch_hi and self.close[0] < watch_hi and
                    self.high[0] < sand_hi[0])

        if go_long:
            entry = self.close[0]
            stop = self.low[0]
            if stop > entry - min_risk:
                stop = entry - min_risk
            t_dir[0] = 1.0
            t_entry[0] = entry
            t_stop[0] = stop
            t_target[0] = entry + 3.0 * (entry - stop)
            t_age[0] = 0.0
        elif go_short:
            entry = self.close[0]
            stop = self.high[0]
            if stop < entry + min_risk:
                stop = entry + min_risk
            t_dir[0] = -1.0
            t_entry[0] = entry
            t_stop[0] = stop
            t_target[0] = entry - 3.0 * (stop - entry)
            t_age[0] = 0.0

    # ------------------------------------------------------------------
    # 6. SIGNAL VALUE: +1 while a BUY is open, -1 while a SELL is open, 0 flat
    # ------------------------------------------------------------------
    signal_color = color.GRAY
    if t_dir[0] > 0.5:
        signal_color = color.GREEN
    if t_dir[0] < -0.5:
        signal_color = color.RED
    return plot.Line(t_dir[0], color=signal_color)
