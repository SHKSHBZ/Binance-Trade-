# indie:lang_version = 5
# ==========================================================================
#  GOLD METHOD ASSISTANT  (v3)  --  Exness Terminal (Indie language)
#  FIX: grabbed liquidity now STAYS gray in place; the next pending target
#  shows separately in bright colour.
#    - PENDING high  = ORANGE (untapped target above)
#    - GRABBED high   = GRAY   (already taken, frozen where it was swept)
#    - PENDING low   = AQUA   (untapped target below)
#    - GRABBED low    = GRAY
#  Trend EMA: green = longs only / red = shorts only.
#  (Next: BUY/SELL break markers, and optional structure-based trend.)
# ==========================================================================
from math import nan
from indie import indicator, param, plot, color, MutSeriesF
from indie.algorithms import Ema


@indicator('Gold Method Assistant', overlay_main_pane=True)
@param.int('trend_len', default=200, min=5, title='Trend EMA length')
@plot.line(title='Trend EMA')
@plot.line(title='Pending High')
@plot.line(title='Grabbed High')
@plot.line(title='Pending Low')
@plot.line(title='Grabbed Low')
def Main(self, trend_len):
    trend = Ema.new(self.close, trend_len)
    up = self.close[0] > trend[0]
    trend_color = color.GREEN if up else color.RED

    # ---- swing pivots, strength 5 (confirmed 5 bars back) ----
    hc = self.high[5]
    is_ph = (hc > self.high[0] and hc > self.high[1] and hc > self.high[2] and
             hc > self.high[3] and hc > self.high[4] and hc > self.high[6] and
             hc > self.high[7] and hc > self.high[8] and hc > self.high[9] and hc > self.high[10])
    lc = self.low[5]
    is_pl = (lc < self.low[0] and lc < self.low[1] and lc < self.low[2] and
             lc < self.low[3] and lc < self.low[4] and lc < self.low[6] and
             lc < self.low[7] and lc < self.low[8] and lc < self.low[9] and lc < self.low[10])

    # ---- persistent pending + grabbed HIGH ----
    pend_hi = MutSeriesF.new(nan)
    grab_hi = MutSeriesF.new(nan)
    pend_hi[0] = pend_hi[1]
    grab_hi[0] = grab_hi[1]
    if is_ph:
        if self.close[0] < hc:          # a fresh high still above price -> target
            pend_hi[0] = hc
        else:                            # already below price -> already taken
            grab_hi[0] = hc
    if pend_hi[0] == pend_hi[0] and self.high[0] > pend_hi[0]:   # target just taken
        grab_hi[0] = pend_hi[0]
        pend_hi[0] = nan

    # ---- persistent pending + grabbed LOW ----
    pend_lo = MutSeriesF.new(nan)
    grab_lo = MutSeriesF.new(nan)
    pend_lo[0] = pend_lo[1]
    grab_lo[0] = grab_lo[1]
    if is_pl:
        if self.close[0] > lc:
            pend_lo[0] = lc
        else:
            grab_lo[0] = lc
    if pend_lo[0] == pend_lo[0] and self.low[0] < pend_lo[0]:
        grab_lo[0] = pend_lo[0]
        pend_lo[0] = nan

    return (
        plot.Line(trend[0], color=trend_color),
        plot.Line(pend_hi[0], color=color.ORANGE),
        plot.Line(grab_hi[0], color=color.GRAY),
        plot.Line(pend_lo[0], color=color.AQUA),
        plot.Line(grab_lo[0], color=color.GRAY),
    )
